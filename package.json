{
  "name": "dead-styles",
  "version": "0.1.3",
  "description": "Find unused CSS-in-JS classes (tss-react / MUI makeStyles / JSS) across your whole project, not just one file",
  "type": "module",
  "bin": {
    "dead-styles": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-vm-modules node_modules/.bin/vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "css-in-js",
    "tss-react",
    "makeStyles",
    "mui",
    "jss",
    "unused-css",
    "dead-code",
    "static-analysis",
    "knip"
  ],
  "author": "frontbond",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontbond/dead-styles.git"
  },
  "bugs": {
    "url": "https://github.com/frontbond/dead-styles/issues"
  },
  "homepage": "https://github.com/frontbond/dead-styles#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
